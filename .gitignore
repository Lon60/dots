# generated per device by nwg-displays (written through the ~/.config/hypr symlink)
hypr/monitors.lua
hypr/workspaces.lua

# machine-local fish state 
fish/fish_variables
fish/conf.d/
fish/completions/
fish/functions/
fish/auto-Hypr.fish

# ~/.pi: only settings.json + extensions/ are synced (see pi/README.md).
# Secrets, transcripts and rebuildable package trees never enter the repo.
pi/agent/auth.json
pi/agent/sessions/
pi/agent/npm/
pi/agent/git/
pi/agent/models-store.json
pi/agent/.cache/
